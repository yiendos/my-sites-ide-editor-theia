{
	"folders": [
		{
			"name": "Packages",
			"path": "../Packages"
		},
		{
			"name": "__PROJECT__",
			"path": "."
		}
	],
	"settings": {
		"intelephense.environment.phpVersion": "8.4",
		"intelephense.environment.includePaths": [
			"/home/project/__APP_PATH__/vendor",
			"/home/project/__APP_PATH__/_ide_helper.php",
			"/home/project/__APP_PATH__/_ide_helper_models.php",
			"/home/project/__APP_PATH__/.phpstorm.meta.php"
		],
		"intelephense.files.exclude": [
			"**/.git/**",
			"**/.svn/**",
			"**/.hg/**",
			"**/CVS/**",
			"**/.DS_Store/**",
			"**/node_modules/**",
			"**/bower_components/**",
			"**/vendor/**/{Tests,tests}/**"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Listen for Xdebug",
				"type": "php",
				"request": "launch",
				"port": 9003,
				"xdebugSettings": {
					"max_data": -1
				},
				"pathMappings": {
					"/opt/repos/__PROJECT__": "${workspaceFolder:__PROJECT__}",
					"/opt/Packages": "${workspaceFolder:Packages}"
				}
			}
		]
	}
}
